<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %></title>
</head>
<body>
    
    <h1>Product list</h1>
    <ul class="list-group list-group-flush">

        <% products.forEach((item) => { %>
            <li class="list-group-item">
                <%= item.id %> - <%= item.name %> <%= item.price %>
                <br>
                <%= item.description %>
            </li>
        <% }); %>

    </ul>

</body>
</html>